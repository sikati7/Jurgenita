# Copiez ce fichier en .env et remplissez ce dont vous avez besoin.
# Guide pas à pas : CONNEXIONS.md

# --- Cerveau (obligatoire pour sortir du mode démo) ---
ANTHROPIC_API_KEY=
# JURGENITA_MODEL=claude-opus-5-5

# --- Gmail + Google Agenda ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Accès de la PREMIÈRE marque (facultatif) ---
# Chaque marque peut aussi recevoir ses accès dans Profil → Accès de la marque.
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_PAGE_ID=
META_AD_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION=
TIKTOK_ACCESS_TOKEN=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_ID=
# META_GRAPH_VERSION=v23.0
# LINKEDIN_VERSION=202509

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Divers ---
# PORT=3000
# JURGENITA_DEMO=1   # force le mode démo
# JURGENITA_NO_SCHEDULER=1   # coupe la publication programmée
